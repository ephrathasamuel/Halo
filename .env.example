# Halo settings. Copy to .env.local (never commit .env.local) and add the same
# values in Vercel > Settings > Environment Variables (site URL differs).

# Address of the site: http://localhost:3000 locally, your vercel.app address on Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API Keys). Without these Halo stores data in .halo-data/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Long random text that signs sign-in cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HALO_SESSION_SECRET=

# The global admin account (created on first start). Write $ as \$ in .env files.
HALO_ADMIN_EMAIL=
HALO_ADMIN_PASSWORD=
